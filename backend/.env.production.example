APP_NAME=GOAL
APP_ENV=production
APP_KEY=                          # Generate: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # warning or error for production

# ======================================================
# DATABASE — PostgreSQL
# ======================================================
DB_CONNECTION=pgsql
DB_HOST=postgres                  # Docker service name, or your DB host
DB_PORT=5432
DB_DATABASE=project_goal
DB_USERNAME=postgres
DB_PASSWORD=                      # WAJIB: isi dengan password yang aman
DB_SSLMODE=require                # Gunakan require untuk production

# ======================================================
# SESSION
# ======================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=

# ======================================================
# QUEUE & CACHE
# ======================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ======================================================
# REDIS (opsional, untuk cache & queue di production)
# ======================================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# ======================================================
# MAIL
# ======================================================
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=                    # WAJIB: jangan commit nilai nyata
MAIL_SCHEME=tls
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ======================================================
# SUPABASE STORAGE
# ======================================================
SUPABASE_URL=                     # WAJIB: URL project Supabase
SUPABASE_SERVICE_KEY=             # WAJIB: service role key, JANGAN public
SUPABASE_BUCKET=Goal

# ======================================================
# SANCTUM TOKEN
# ======================================================
SANCTUM_TOKEN_EXPIRATION=1440     # 24 jam

# ======================================================
# APP SETTINGS
# ======================================================
FRONTEND_URL=https://your-frontend-domain.com
TELESCOPE_ENABLED=false           # WAJIB false di production

# ======================================================
# BOOKING CONFIG
# ======================================================
BOOKING_AUTO_CANCEL_MINUTES_BEFORE=30
